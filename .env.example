# Copy this file to ".env" and fill in your real values.
# The real .env is git-ignored so your secrets never get committed.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# --- Classifier (needed to run classify/classify.py) ---
# Get a FREE key at https://aistudio.google.com/apikey . Without it, the classifier
# prints how to get one and exits (does nothing).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # optional override; a free-tier model is the default

# --- Email distribution (OPTIONAL — only needed to actually SEND the brief, Day 6) ---
# Leave these blank for now. Without them, distribution/send_brief.py only previews
# (dry run) and cannot send anything. Fill them in with your email provider's SMTP
# details when you're ready to go live.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
SITE_URL=https://policypulse.example.com
